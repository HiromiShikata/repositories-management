{
  "name": "template-typescript",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prebuild": "npm run doctor",
    "doctor:node-version": "check-node-version --node 24 --npx 10 --npm 10",
    "doctor": "npm run doctor:node-version",
    "prettier": "prettier --write '**/*'",
    "lint": "eslint src",
    "lint-fix": "eslint src --fix",
    "fmt": "npm run prettier && npm run lint-fix",
    "build": "tsc -p ./tsconfig.build.json",
    "test": "jest",
    "prepare": "git config core.hooksPath scripts/typescript/.husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiromiShikata/template-typescript.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HiromiShikata/template-typescript/issues"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/git"
    ],
    "branches": [
      "main"
    ]
  },
  "homepage": "https://github.com/HiromiShikata/template-typescript#readme",
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "check-node-version": "^4.2.1",
    "commitlint": "^21.0.0",
    "conventional-changelog-conventionalcommits": "^10.0.0",
    "eslint": "^8.44.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-no-type-assertion": "^1.3.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "gh-cookie": "1.3.24",
    "husky": "9.1.7",
    "jest": "^30.0.0",
    "jest-html-reporter": "^4.4.0",
    "jest-junit": "^17.0.0",
    "prettier": "^3.0.0",
    "semantic-release": "^25.0.0",
    "semver": "^7.8.5",
    "ts-jest": "^29.4.7",
    "ts-node": "^10.9.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "dotenv": "^16.6.1",
    "gh-projects-working-time-reporter": "^1.2.5"
  },
  "overrides": {
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
    "picomatch@>=4.0.0 <4.0.4": "4.0.4",
    "ip-address@>=10.0.0 <=10.3.0": "10.5.0"
  }
}
